{
  "name": "dhundo",
  "private": true,
  "version": "0.1.0",
  "description": "Internal bug tracking system — cross-platform (iOS, Android, Windows)",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @dhundo/mobile web",
    "dev:backend": "pnpm --filter @dhundo/backend dev",
    "web": "pnpm --filter @dhundo/mobile web",
    "build": "turbo run build",
    "build:web": "pnpm --filter @dhundo/mobile build:web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
