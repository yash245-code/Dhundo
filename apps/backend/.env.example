# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/dhundo"

# JWT
JWT_SECRET="change_me_to_a_long_random_secret_at_least_64_chars"
JWT_REFRESH_SECRET="change_me_to_another_long_random_secret_for_refresh_tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# File Storage (choose one)
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dhundo-attachments

# Cloudflare R2 (S3-compatible)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=dhundo-attachments
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Frontend
FRONTEND_URL=http://localhost:8081
